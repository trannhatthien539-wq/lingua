<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget màn hình chính của Lingua (4x2).
  Layout chỉ dùng các view mà RemoteViews hỗ trợ (TextView/LinearLayout) để tránh lỗi khi update.
  Nội dung được JS đẩy sang qua plugin `LinguaWidget` (xem src/services/widgetBridge.js).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lingua_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lingua_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/lingua_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="@string/lingua_widget_title"
        android:textAllCaps="true"
        android:textColor="#8FA79A"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/lingua_widget_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/lingua_widget_hint"
        android:textColor="#D9F06D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lingua_widget_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#E4EAE4"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lingua_widget_tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#9FB2A6"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/lingua_widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#223B4A42"
        android:progressTint="#8FA79A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lingua_widget_button_practice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/lingua_widget_button"
            android:gravity="center"
            android:minHeight="38dp"
            android:text="@string/lingua_widget_practice"
            android:textColor="#18201D"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lingua_widget_button_grammar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/lingua_widget_button_ghost"
            android:gravity="center"
            android:minHeight="38dp"
            android:text="@string/lingua_widget_grammar"
            android:textColor="#F3F5F3"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lingua_widget_button_vstep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/lingua_widget_button_ghost"
            android:gravity="center"
            android:minHeight="34dp"
            android:text="@string/lingua_widget_vstep"
            android:textColor="#F3F5F3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/lingua_widget_button_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/lingua_widget_button_ghost"
            android:gravity="center"
            android:minHeight="34dp"
            android:text="@string/lingua_widget_progress"
            android:textColor="#F3F5F3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lingua_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#7C8F84"
        android:textSize="10sp" />
</LinearLayout>
